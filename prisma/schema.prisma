// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WatchStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

enum PushProvider {
  WEB_PUSH
  APNS
  FCM
}

enum PushSubscriptionStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum NotificationType {
  AIRING_TONIGHT
  AIRING_THIS_WEEK
  NEW_SEASON_THIS_WEEK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authUserId String  @unique
  username   String? @unique
  firstName  String?
  lastName   String?

  profileImageUrl String?

  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]

  shows     UserShow[]
  followers Follows[]  @relation("following")
  following Follows[]  @relation("follower")
}

model Follows {
  follower   User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String

  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Show {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tvmazeId Int     @unique
  name     String
  imageUrl String?

  status              String?
  network             String?
  nextEpisodeDate     DateTime?
  nextEpisodeTvmazeId Int?
  nextEpisodeName     String?
  nextEpisodeSeason   Int?
  nextEpisodeNumber   Int?

  notificationLogs NotificationLog[]

  users UserShow[]

  @@index([name])
  @@index([nextEpisodeDate])
}

model UserShow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  showId String
  show   Show?  @relation(fields: [showId], references: [id], onDelete: Cascade)

  status WatchStatus @default(PLANNED)

  @@unique([userId, showId])
  @@index([userId])
  @@index([status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform PushPlatform
  provider PushProvider
  status   PushSubscriptionStatus @default(ACTIVE)

  endpoint String? @unique
  token    String? @unique

  p256dh String?
  auth   String?

  userAgent    String?
  deviceName   String?
  lastSeenAt   DateTime?
  disabledAt   DateTime?
  failureCount Int       @default(0)

  @@index([userId])
  @@index([status])
  @@index([platform])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushEnabled Boolean @default(false)

  airingTonightEnabled     Boolean @default(true)
  airingThisWeekEnabled    Boolean @default(true)
  newSeasonThisWeekEnabled Boolean @default(true)

  timezone String?
}

model NotificationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  type   NotificationType
  status NotificationStatus @default(PENDING)

  eventKey      String
  scheduledFor  DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  @@unique([userId, showId, type, eventKey])
  @@index([userId])
  @@index([showId])
  @@index([type])
  @@index([status])
  @@index([scheduledFor])
}
