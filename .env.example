# Database
# Use the pooled production connection string for the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"

# Use the direct, non-pooled connection string for Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Site URL
BASE_ADDRESS="http://localhost:3000"

# Optional: lets smoke tests target production without changing local BASE_ADDRESS.
SMOKE_BASE_ADDRESS="https://getbingd.com"

# Optional: paste the Google Search Console HTML tag content value here.
GOOGLE_SITE_VERIFICATION=""

# Clerk
# Use pk_live/sk_live values in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Scheduled jobs
# Add this before exposing sync/notification routes in production.
CRON_SECRET="replace-with-a-long-random-secret"

# Optional: cap TVMaze show refreshes per daily cron run.
SYNC_SHOWS_PER_RUN="75"

# Web Push
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY="replace-with-vapid-public-key"
WEB_PUSH_PRIVATE_KEY="replace-with-vapid-private-key"
WEB_PUSH_CONTACT="mailto:you@example.com"

# Diagnostics
NEXT_PUBLIC_ENABLE_TEST_NOTIFICATIONS="false"
